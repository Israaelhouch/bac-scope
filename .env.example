# Groq API key — only needed for the /ask natural-language endpoint
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Model used to translate questions into SQL.
# Leave blank to use the built-in default (openai/gpt-oss-20b), picked by
# scoring candidates on the eval suite rather than by guessing.
# See what your key can use:  python -m scripts.eval --list-models
# Score a candidate:          python -m scripts.eval --model <id>
GROQ_MODEL=openai/gpt-oss-20b
